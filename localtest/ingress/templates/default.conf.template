# localtest ingress: one origin, local.altinn.cloud:8000, split by path prefix.
# Upstreams are variables so nginx starts even when a component is not running (resolved per request).
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# PDF generator on its own host name, as in production and studioctl.
server {
    listen 8000;
    server_name pdf.local.altinn.cloud;
    set $pdf ${PDF_UPSTREAM};
    location / { proxy_pass $pdf; proxy_http_version 1.1; proxy_set_header Host $http_host; }
}

# Workflow engine on its own host name, as in studioctl.
server {
    listen 8000;
    server_name workflow-engine.local.altinn.cloud;
    set $workflow_engine ${WORKFLOW_ENGINE_UPSTREAM};
    location / { proxy_pass $workflow_engine; proxy_http_version 1.1; proxy_set_header Host $http_host; }
}

server {
    listen 8000 default_server;
    server_name local.altinn.cloud _;

    client_max_body_size 200m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;

    # Production services set Secure cookies; the browser talks plain http to this origin.
    proxy_cookie_flags ~ nosecure;

    set $register       ${REGISTER_UPSTREAM};
    set $authentication ${AUTHENTICATION_UPSTREAM};
    set $authorization  ${AUTHORIZATION_UPSTREAM};
    set $access_management ${ACCESS_MANAGEMENT_UPSTREAM};
    set $storage        ${STORAGE_UPSTREAM};

    location /register/         { proxy_pass $register; }
    location /profile/          { proxy_pass $register; }
    location /authentication/   { proxy_pass $authentication; }
    location /Home/             { proxy_pass $authentication; }
    # The start page (test-user select) lives at the root, and /Home without a slash is one of its routes.
    location = /                { proxy_pass $authentication; }
    location = /Home            { proxy_pass $authentication; }
    location /authorization/    { proxy_pass $authorization; }
    # Production Access Management: authorized parties, the PDP's PIP, the apps' instance delegations and the app
    # runner's refresh.
    location /accessmanagement/ { proxy_pass $access_management; }
    location /storage/          { proxy_pass $storage; }

    # The app-frontend bundle built from src/App/frontend (dist mounted at /frontend), served as the app's asset base.
    location /app-frontend/ {
        alias /frontend/;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control no-cache;
    }

    location = /health { return 200 'ok'; add_header Content-Type text/plain; }

    # Apps on the developer machine: the app runner (run-app.sh) drops one location per app into ingress/app-routes/
    # (mounted at /etc/nginx/app-routes) and reloads nginx. Nothing else is guessed: an app path without a route is
    # a 404, never another app's answer.
    include /etc/nginx/app-routes/*.conf;
    location / {
        default_type text/plain;
        return 404 'No app is registered for this path. Start it with run-app.sh <app-dir> <port>.\n';
    }
}
