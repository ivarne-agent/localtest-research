# localtest ingress: one origin, local.altinn.cloud:8000, split by path prefix.
# Upstreams are variables so nginx starts even when a component is not running (resolved per request).
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8000;
    server_name local.altinn.cloud _;

    client_max_body_size 200m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;

    # Production services set Secure cookies; the browser talks plain http to this origin.
    proxy_cookie_flags ~ nosecure;

    set $register       ${REGISTER_UPSTREAM};
    set $authentication ${AUTHENTICATION_UPSTREAM};
    set $authorization  ${AUTHORIZATION_UPSTREAM};
    set $storage        ${STORAGE_UPSTREAM};
    set $app            ${APP_UPSTREAM};

    location /register/       { proxy_pass $register; }
    location /authentication/ { proxy_pass $authentication; }
    location /Home/           { proxy_pass $authentication; }
    location /authorization/  { proxy_pass $authorization; }
    location /storage/        { proxy_pass $storage; }

    location = /health { return 200 'ok'; add_header Content-Type text/plain; }

    # Everything else is an app: /{org}/{app}/... served by the app process on the developer machine.
    location / { proxy_pass $app; }
}
