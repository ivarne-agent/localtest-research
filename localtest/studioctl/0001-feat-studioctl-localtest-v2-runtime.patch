+
+// The shared test certificate: every app and component signs platform access tokens with it, and the
+// components validate the tokens against it, so the production token handlers run unchanged. It is a
+// test key pair, public in the localtest-research repository (localtest/certs/README.md).
+//
+//go:embed assets/localtest-accesstoken.pfx
+var accessTokenCertificate []byte
+
+// ensureCertificate writes the shared test certificate where the containers and the apps read it, and
+// returns its directory.
+func ensureCertificate(dir string) error {
+	if err := os.MkdirAll(dir, osutil.DirPermDefault); err != nil {
+		return fmt.Errorf("create certificate directory: %w", err)
+	}
+	path := filepath.Join(dir, localtestv2.CertificateFileName)
+	existing, err := os.ReadFile(path) //nolint:gosec // the path is under studioctl's own data directory
+	if err == nil && bytes.Equal(existing, accessTokenCertificate) {
+		return nil
+	}
+	// World-readable on purpose: the containers run as their image users, not as the developer.
+	if err := os.WriteFile(path, accessTokenCertificate, osutil.FilePermDefault); err != nil {
+		return fmt.Errorf("write certificate: %w", err)
+	}
+	return nil
+}
diff --git a/src/cli/internal/cmd/env/localtestv2/components.go b/src/cli/internal/cmd/env/localtestv2/components.go
new file mode 100644
index 0000000000..cfd31db2c2
--- /dev/null
+++ b/src/cli/internal/cmd/env/localtestv2/components.go
@@ -0,0 +1,575 @@
+package localtestv2
+
+import (
+	"path/filepath"
+	"slices"
+	"time"
+
+	"altinn.studio/devenv/pkg/container/types"
+	"altinn.studio/devenv/pkg/resource"
+	"altinn.studio/studioctl/internal/config"
+	"altinn.studio/studioctl/internal/envtopology"
+	"altinn.studio/studioctl/internal/localtestv2"
+)
+
+// Component names: the container is containerPrefix + name, the dev build context is components/<name> in
+// the research checkout, and `env logs --component <name>` selects it.
+const (
+	componentPostgres         = "postgres"
+	componentRegister         = "register"
+	componentAuthentication   = "authentication"
+	componentAuthorization    = "authorization"
+	componentAccessManagement = "access-management"
+	componentStorage          = "storage"
+	componentEvents           = "events"
+	componentLocaltest        = "localtest"
+	componentPDF              = "pdf3"
+	componentWorkflowEngine   = "workflow-engine"
+)
+
+// Host ports, loopback only. The proxy in studioctl-server forwards to these; 5300 is also what app-lib's
+// PlatformSettings default ApiPdf2Endpoint (http://localhost:5300/pdf) names.
+const (
+	hostPortRegister         = "8020"
+	hostPortAuthentication   = "8021"
+	hostPortAuthorization    = "8022"
+	hostPortAccessManagement = "8023"
+	hostPortStorage          = "8024"
+	hostPortEvents           = "8025"
+	hostPortLocaltest        = "8026"
+	hostPortWorkflowEngine   = "8028"
+	hostPortPDF              = "5300"
+)
+
+// Named volumes. Each is owned by the image user that writes it (blobs uid 1654, the policy store uid 1000,
+// localtest data uid 1654), which the runtime arranges on first use.
+const (
+	volumePostgresData  = "localtest-v2-postgres-data"
+	volumeStorageBlobs  = "localtest-v2-storage-blobs"
+	volumePolicyStore   = "localtest-v2-policy-store"
+	volumeLocaltestData = "localtest-v2-localtest-data"
+)
+
+const (
+	// networkName is the localtest-v2 container network. Containers find Postgres on it; everything else
+	// they reach through the public origin on the host.
+	networkName     = "localtest-v2_network"
+	containerPrefix = "localtest-v2-"
+
+	postgresAlias    = "postgres"
+	postgresUser     = "postgres"
+	postgresPassword = "postgres"
+	postgresPort     = "5432"
+
+	postgresHealthInterval    = 2 * time.Second
+	postgresHealthTimeout     = 5 * time.Second
+	postgresHealthRetries     = 30
+	postgresHealthStartPeriod = 5 * time.Second
+
+	certContainerDir  = "/certs"
+	certContainerPath = certContainerDir + "/" + localtestv2.CertificateFileName
+	certSettingEnv    = "AccessTokenSettings__AccessTokenSigningCertificateFullPath"
+
+	// Containers reach the public origin, served by studioctl-server on the host, through the runtime's host
+	// gateway (hostGateway maps every ingress hostname to it: the PDF generator's browser loads the app's
+	// frontend assets from app-frontend.local.altinn.cloud when `studioctl run --dev-frontend` serves them).
+	// Events also delivers webhooks to the developer's machine by the conventional name.
+	hostGateway             = "host-gateway"
+	hostDockerInternalEntry = "host.docker.internal:" + hostGateway
+
+	frontendDevServerHostPort = "8080"
+	loopback                  = "127.0.0.1"
+	healthPath                = "/health"
+)
+
+// route is one public host-and-prefix the proxy forwards to a component; an empty prefix matches the whole host.
+type route struct {
+	host   string
+	prefix string
+}
+
+// component is one container of the environment and how the proxy and the health wait reach it.
+type component struct {
+	healthCheck *types.HealthCheck
+	env         map[string]string
+	name        string
+	image       config.ImageSpec
+	// devContext is the build context under the research checkout for a dev build; empty when the component
+	// is not built from that checkout (the PDF generator and the workflow engine come from the monorepo).
+	devContext    string
+	containerPort string
+	hostPort      string
+	// healthPath is polled on hostPort over HTTP after the containers run; empty skips the poll.
+	healthPath     string
+	volumes        []types.VolumeMount
+	extraHosts     []string
+	aliases        []string
+	deps           []string
+	routes         []route
+	useDefaultUser bool
+}
+
+func (c component) containerName() string {
+	return containerPrefix + c.name
+}
+
+func (c component) hostURL() string {
+	return "http://" + loopback + ":" + c.hostPort
+}
+
+// Options configures the component set.
+type Options struct {
+	DevComponents map[string]bool
+	CertDir       string
+	DevSourceRoot string
+	RuntimeUser   string
+	UsernsMode    string
+	Images        config.ImagesConfig
+	Topology      envtopology.Local
+	RelabelBinds  bool
+}
+
+// ingressHostEntries maps every public hostname to the host, where studioctl-server serves them.
+func ingressHostEntries(opts *Options) []string {
+	hosts := opts.Topology.LocaltestIngressHosts()
+	entries := make([]string, 0, len(hosts))
+	for _, host := range hosts {
+		entries = append(entries, host+":"+hostGateway)
+	}
+	return entries
+}
+
+// newComponent is a service with its own image user and no host-writable mounts, which every component is.
+func newComponent(
+	opts *Options,
+	name string,
+	image config.ImageSpec,
+	devContext, containerPort, hostPort string,
+) component {
+	return component{
+		healthCheck:    nil,
+		env:            nil,
+		name:           name,
+		image:          image,
+		devContext:     devContext,
+		containerPort:  containerPort,
+		hostPort:       hostPort,
+		healthPath:     "",
+		volumes:        nil,
+		extraHosts:     ingressHostEntries(opts),
+		aliases:        nil,
+		deps:           nil,
+		routes:         nil,
+		useDefaultUser: true,
+	}
+}
+
+func containerOf(name string) string {
+	return containerPrefix + name
+}
+
+// components returns the environment's containers in start order.
+func components(opts *Options) []component {
+	platform := opts.Topology.LocaltestBaseURL() + "/"
+	return []component{
+		postgresComponent(opts),
+		registerComponent(opts, platform),
+		authenticationComponent(opts, platform),
+		authorizationComponent(opts, platform),
+		storageComponent(opts, platform),
+		accessManagementComponent(opts, platform),
+		eventsComponent(opts, platform),
+		localtestComponent(opts, platform),
+		pdfComponent(opts),
+		workflowEngineComponent(opts),
+	}
+}
+
+func postgresComponent(opts *Options) component {
+	c := newComponent(opts, componentPostgres, opts.Images.LocaltestV2.Postgres, ".", postgresPort, "")
+	c.env = map[string]string{
+		"POSTGRES_USER":     postgresUser,
+		"POSTGRES_PASSWORD": postgresPassword,
+		"TZ":                "Europe/Oslo",
+	}
+	c.volumes = []types.VolumeMount{namedVolume(volumePostgresData, "/var/lib/postgresql")}
+	c.aliases = []string{postgresAlias}
+	c.extraHosts = nil
+	c.healthCheck = &types.HealthCheck{
+		Test:        []string{"CMD-SHELL", "pg_isready -h 127.0.0.1 -p " + postgresPort + " -U " + postgresUser},
+		Interval:    postgresHealthInterval,
+		Timeout:     postgresHealthTimeout,
+		Retries:     postgresHealthRetries,
+		StartPeriod: postgresHealthStartPeriod,
+	}
+	return c
+}
+
+func registerComponent(opts *Options, platform string) component {
+	c := newComponent(
+		opts,
+		componentRegister,
+		opts.Images.LocaltestV2.Register,
+		"components/register",
+		"5020",
+		hostPortRegister,
+	)
+	c.healthPath = healthPath
+	c.env = map[string]string{
+		certSettingEnv: certContainerPath,
+		"GeneralSettings__OpenIdWellKnownEndpoint":   platform + "authentication/api/v1/openid/",
+		"PlatformSettings__ApiAuthorizationEndpoint": platform + "authorization/api/v1/",
+	}
+	c.volumes = []types.VolumeMount{certMount(opts)}
+	appHost := opts.Topology.AppHostName()
+	c.routes = []route{{host: appHost, prefix: "/register"}, {host: appHost, prefix: "/profile"}}
+	return c
+}
+
+func authenticationComponent(opts *Options, platform string) component {
+	c := newComponent(
+		opts,
+		componentAuthentication,
+		opts.Images.LocaltestV2.Authentication,
+		"components/authentication",
+		"5101",
+		hostPortAuthentication,
+	)
+	c.healthPath = healthPath
+	c.env = map[string]string{
+		certSettingEnv:                      certContainerPath,
+		"GeneralSettings__PlatformEndpoint": platform,
+	}
+	c.volumes = []types.VolumeMount{certMount(opts)}
+	c.deps = []string{containerOf(componentRegister)}
+	c.routes = []route{{host: opts.Topology.AppHostName(), prefix: "/authentication"}}
+	return c
+}
+
+func authorizationComponent(opts *Options, platform string) component {
+	c := newComponent(
+		opts,
+		componentAuthorization,
+		opts.Images.LocaltestV2.Authorization,
+		"components/authorization",
+		"5070",
+		hostPortAuthorization,
+	)
+	c.healthPath = healthPath
+	c.env = map[string]string{
+		certSettingEnv: certContainerPath,
+		"Localtest__Authorization__PlatformEndpoint": platform,
+	}
+	c.volumes = []types.VolumeMount{certMount(opts), namedVolume(volumePolicyStore, "/policy-store")}
+	c.deps = []string{containerOf(componentRegister)}
+	c.routes = []route{{host: opts.Topology.AppHostName(), prefix: "/authorization"}}
+	return c
+}
+
+func storageComponent(opts *Options, platform string) component {
+	c := newComponent(
+		opts,
+		componentStorage,
+		opts.Images.LocaltestV2.Storage,
+		"components/storage",
+		"5010",
+		hostPortStorage,
+	)
+	c.healthPath = healthPath
+	c.env = map[string]string{
+		certSettingEnv:                      certContainerPath,
+		"GeneralSettings__PlatformEndpoint": platform,
+		"PostgreSqlSettings__AdminConnectionString": "Host=" + postgresAlias + ";Port=" + postgresPort +
+			";Username=platform_storage_admin;Password={0};Database=storagedb",
+		"PostgreSqlSettings__ConnectionString": "Host=" + postgresAlias + ";Port=" + postgresPort +
+			";Username=platform_storage;Password={0};Database=storagedb;Include Error Detail=True",
+	}
+	c.volumes = []types.VolumeMount{certMount(opts), namedVolume(volumeStorageBlobs, "/data/blobs")}
+	c.deps = []string{containerOf(componentPostgres)}
+	c.routes = []route{{host: opts.Topology.AppHostName(), prefix: "/storage"}}
+	return c
+}
+
+func accessManagementComponent(opts *Options, platform string) component {
+	c := newComponent(
+		opts,
+		componentAccessManagement,
+		opts.Images.LocaltestV2.AccessManagement,
+		"components/access-management",
+		"5080",
+		hostPortAccessManagement,
+	)
+	c.healthPath = healthPath
+	c.env = map[string]string{
+		certSettingEnv: certContainerPath,
+		"Localtest__AccessManagement__PlatformEndpoint": platform,
+	}
+	c.volumes = []types.VolumeMount{certMount(opts), namedVolume(volumePolicyStore, "/policy-store")}
+	// Its startup refresh reads the Register's streams and Storage's application list.
+	c.deps = []string{containerOf(componentPostgres), containerOf(componentRegister), containerOf(componentStorage)}
+	c.routes = []route{{host: opts.Topology.AppHostName(), prefix: "/accessmanagement"}}
+	return c
+}
+
+func eventsComponent(opts *Options, platform string) component {
+	c := newComponent(
+		opts,
+		componentEvents,
+		opts.Images.LocaltestV2.Events,
+		"components/events",
+		"5080",
+		hostPortEvents,
+	)
+	c.healthPath = healthPath
+	c.env = map[string]string{
+		certSettingEnv:                        certContainerPath,
+		"Localtest__Events__PlatformEndpoint": platform,
+		"PostgreSQLSettings__AdminConnectionString": "Host=" + postgresAlias + ";Port=" + postgresPort +
+			";Username=platform_events_admin;Password={0};Database=eventsdb",
+		"PostgreSQLSettings__ConnectionString": "Host=" + postgresAlias + ";Port=" + postgresPort +
+			";Username=platform_events;Password={0};Database=eventsdb;Include Error Detail=True",
+	}
+	// Events never binds AccessTokenSettings for its outgoing platform tokens, so its production
+	// SigningCredentialsResolver reads the default path relative to /app.
+	eventsCert := readOnlyBind(
+		filepath.Join(opts.CertDir, localtestv2.CertificateFileName),
+		"/accesstoken/accesstokencredentials.pfx",
+	)
+	c.volumes = []types.VolumeMount{certMount(opts), eventsCert}
+	c.extraHosts = append(ingressHostEntries(opts), hostDockerInternalEntry)
+	c.deps = []string{
+		containerOf(componentPostgres),
+		containerOf(componentRegister),
+		containerOf(componentAuthorization),
+	}
+	c.routes = []route{{host: opts.Topology.AppHostName(), prefix: "/events"}}
+	return c
+}
+
+func localtestComponent(opts *Options, platform string) component {
+	c := newComponent(
+		opts,
+		componentLocaltest,
+		opts.Images.LocaltestV2.Localtest,
+		"localtest",
+		"8000",
+		hostPortLocaltest,
+	)
+	c.healthPath = healthPath
+	c.env = map[string]string{
+		"Localtest__PlatformEndpoint":           platform,
+		"Localtest__AccessTokenCertificatePath": certContainerPath,
+		// Its test-user picker and token helpers call the Register and Authentication through the public
+		// origin, as everything else does (the app's own proxy is not used here).
+		"Proxy__Upstreams__register":       opts.Topology.LocaltestBaseURL(),
+		"Proxy__Upstreams__authentication": opts.Topology.LocaltestBaseURL(),
+	}
+	c.volumes = []types.VolumeMount{certMount(opts), namedVolume(volumeLocaltestData, "/data")}
+	// Everything the prefixes above do not claim: /, /Home, /localtest/api, /app-frontend.
+	c.routes = []route{{host: opts.Topology.AppHostName(), prefix: ""}}
+	return c
+}
+
+func pdfComponent(opts *Options) component {
+	c := newComponent(opts, componentPDF, opts.Images.Core.PDF3, "", "5031", hostPortPDF)
+	c.healthPath = "/health/ready"
+	c.env = map[string]string{
+		"TZ":                             "Europe/Oslo",
+		"PDF3_ENVIRONMENT":               "localtest",
+		"PDF3_QUEUE_SIZE":                "3",
+		"PDF3_LOCALTEST_PUBLIC_BASE_URL": opts.Topology.LocaltestBaseURL(),
+	}
+	c.routes = []route{{host: opts.Topology.PDFHostName(), prefix: ""}}
+	return c
+}
+
+func workflowEngineComponent(opts *Options) component {
+	c := newComponent(
+		opts,
+		componentWorkflowEngine,
+		opts.Images.Core.WorkflowEngine,
+		"",
+		"9090",
+		hostPortWorkflowEngine,
+	)
+	c.healthPath = "/api/v1/health/ready"
+	c.env = map[string]string{
+		"ASPNETCORE_ENVIRONMENT": "Development",
+		"ASPNETCORE_HTTP_PORTS":  "9090",
+		// No collector runs in this environment; the default exporter would fail against localhost:4317.
+		"EngineSettings__EnableTelemetry": "false",
+		"ConnectionStrings__WorkflowEngine": "Host=" + postgresAlias + ";Port=" + postgresPort +
+			";Database=workflow_engine;Username=" + postgresUser + ";Password=" + postgresPassword,
+		"AppCommandSettings__CommandEndpoint": opts.Topology.LocaltestBaseURL() +
+			"/{Org}/{App}/instances/{InstanceOwnerPartyId}/{InstanceGuid}/workflow-engine-callbacks/",
+	}
+	c.deps = []string{containerOf(componentPostgres)}
+	c.routes = []route{{host: opts.Topology.WorkflowEngineHostName(), prefix: ""}}
+	return c
+}
+
+// DevBuildable lists the components a dev build can produce from the research checkout.
+func DevBuildable() []string {
+	var names []string
+	for _, c := range components(defaultOptions(config.DefaultImages(), "")) {
+		if c.devContext != "" {
+			names = append(names, c.name)
+		}
+	}
+	return names
+}
+
+func defaultOptions(images config.ImagesConfig, certDir string) *Options {
+	return &Options{
+		DevComponents: nil,
+		Images:        images,
+		Topology:      envtopology.NewLocal(envtopology.DefaultIngressPortString()),
+		CertDir:       certDir,
+		DevSourceRoot: "",
+		RuntimeUser:   "",
+		UsernsMode:    "",
+		RelabelBinds:  false,
+	}
+}
+
+func certMount(opts *Options) types.VolumeMount {
+	return readOnlyBind(opts.CertDir, certContainerDir)
+}
+
+func readOnlyBind(hostPath, containerPath string) types.VolumeMount {
+	return types.VolumeMount{
+		HostPath:       hostPath,
+		ContainerPath:  containerPath,
+		Type:           types.VolumeMountTypeBind,
+		SELinuxRelabel: types.SELinuxRelabelNone,
+		ReadOnly:       true,
+	}
+}
+
+func namedVolume(name, containerPath string) types.VolumeMount {
+	return types.VolumeMount{
+		HostPath:       name,
+		ContainerPath:  containerPath,
+		Type:           types.VolumeMountTypeVolume,
+		SELinuxRelabel: types.SELinuxRelabelNone,
+		ReadOnly:       false,
+	}
+}
+
+// resources turns the components into the devenv resource graph: the network, then per component an image
+// (pulled, or built from the research checkout) and a container.
+func resources(opts *Options) []resource.Resource {
+	network := &resource.Network{
+		Enabled: nil,
+		Name:    networkName,
+		Driver:  "bridge",
+		Labels:  nil,
+		Lifecycle: resource.LifecycleOptions{
+			HandleDestroyError: nil,
+			RetainOnDestroy:    false,
+		},
+	}
+	comps := components(opts)
+	out := make([]resource.Resource, 0, 1+2*len(comps))
+	out = append(out, network)
+	for _, c := range comps {
+		image := componentImage(opts, c)
+		out = append(out, image, componentContainer(opts, c, image, resource.Ref(network)))
+	}
+	return out
+}
+
+func componentImage(opts *Options, c component) resource.ImageResource {
+	if opts.DevComponents[c.name] && c.devContext != "" && opts.DevSourceRoot != "" {
+		buildContext := filepath.Join(opts.DevSourceRoot, c.devContext)
+		dockerfile := filepath.Join(buildContext, "Dockerfile")
+		if c.name == componentPostgres {
+			dockerfile = filepath.Join(opts.DevSourceRoot, "postgres", "Dockerfile")
+		}
+		return &resource.BuiltImage{
+			Enabled:     nil,
+			ContextPath: filepath.ToSlash(buildContext),
+			Dockerfile:  filepath.ToSlash(dockerfile),
+			Build:       types.BuildOptions{CacheFrom: nil, CacheTo: nil},
+			Tag:         containerPrefix + c.name + ":dev",
+		}
+	}
+	policy := resource.PullIfNotPresent
+	if c.image.Floating {
+		policy = resource.PullAlwaysAllowStale
+	}
+	return &resource.PulledImage{Enabled: nil, Ref: c.image.Ref(), PullPolicy: policy}
+}
+
+func componentContainer(
+	opts *Options,
+	c component,
+	image resource.ImageResource,
+	network resource.ResourceRef,
+) *resource.Container {
+	var ports []types.PortMapping
+	if c.hostPort != "" {
+		ports = []types.PortMapping{{
+			HostPort:      c.hostPort,
+			ContainerPort: c.containerPort,
+			HostIP:        loopback,
+			Protocol:      "",
+		}}
+	}
+	deps := make([]resource.ResourceRef, 0, len(c.deps))
+	for _, dep := range c.deps {
+		deps = append(deps, resource.RefID(resource.ContainerID(dep)))
+	}
+	user, usernsMode := opts.RuntimeUser, opts.UsernsMode
+	if c.useDefaultUser {
+		user, usernsMode = "", ""
+	}
+	volumes := make([]types.VolumeMount, 0, len(c.volumes))
+	for _, volume := range c.volumes {
+		if opts.RelabelBinds && volume.Type == types.VolumeMountTypeBind {
+			volume.SELinuxRelabel = types.SELinuxRelabelShared
+		}
+		volumes = append(volumes, volume)
+	}
+	env := make([]string, 0, len(c.env))
+	for key, value := range c.env {
+		env = append(env, key+"="+value)
+	}
+	slices.Sort(env)
+
+	return &resource.Container{
+		HealthCheck: c.healthCheck,
+		Name:        c.containerName(),
+		Image:       resource.Ref(image),
+		Enabled:     nil,
+		Networks:    []resource.ResourceRef{network},
+		DependsOn:   deps,
+		Ports:       ports,
+		Volumes:     volumes,
+		Env:         env,
+		Labels:      nil,
+		Command:     nil,
+		ExtraHosts:  c.extraHosts,
+		Lifecycle: resource.ContainerLifecycleOptions{
+			LifecycleOptions: resource.LifecycleOptions{
+				HandleDestroyError: nil,
+				RetainOnDestroy:    false,
+			},
+			WaitForReady: true,
+		},
+		NetworkAliases: c.aliases,
+		RestartPolicy:  "",
+		User:           user,
+		UsernsMode:     usernsMode,
+	}
+}
+
+// containerNames lists the containers in start order, for logs and status.
+func containerNames(opts *Options) []string {
+	comps := components(opts)
+	names := make([]string, 0, len(comps))
+	for _, c := range comps {
+		names = append(names, c.containerName())
+	}
+	return names
+}
diff --git a/src/cli/internal/cmd/env/localtestv2/doc.go b/src/cli/internal/cmd/env/localtestv2/doc.go
new file mode 100644
index 0000000000..d2253bad3a
--- /dev/null
+++ b/src/cli/internal/cmd/env/localtestv2/doc.go
@@ -0,0 +1,10 @@
+// Package localtestv2 runs the localtest-v2 environment: the production platform components (Register,
+// Authentication, the PDP, Access Management, Storage, Events) built by the localtest-research repository,
+// the localtest app that hosts the fake ID-porten, Maskinporten and the /Home test helpers, a shared
+// Postgres, and the PDF generator and workflow engine the localtest runtime also runs.
+//
+// studioctl-server is the front door: it serves the platform's public origin (http://local.altinn.cloud:8000)
+// on the host and forwards each path prefix to the component's loopback-published port, and /{org}/{app} to
+// the app it discovered, so apps keep binding to loopback and there is no host bridge. The components reach
+// the public origin through the container runtime's host gateway.
+package localtestv2
diff --git a/src/cli/internal/cmd/env/localtestv2/env.go b/src/cli/internal/cmd/env/localtestv2/env.go
new file mode 100644
index 0000000000..b22870e426
--- /dev/null
+++ b/src/cli/internal/cmd/env/localtestv2/env.go
@@ -0,0 +1,517 @@
+package localtestv2
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"altinn.studio/devenv/pkg/container"
+	containertypes "altinn.studio/devenv/pkg/container/types"
+	"altinn.studio/devenv/pkg/resource"
+	"altinn.studio/devenv/pkg/resource/executor"
+	containerbackend "altinn.studio/devenv/pkg/resource/executor/container"
+	envtypes "altinn.studio/studioctl/internal/cmd/env"
+	envlocaltest "altinn.studio/studioctl/internal/cmd/env/localtest"
+	v1components "altinn.studio/studioctl/internal/cmd/env/localtest/components"
+	"altinn.studio/studioctl/internal/config"
+	"altinn.studio/studioctl/internal/envtopology"
+	"altinn.studio/studioctl/internal/localtestv2"
+	"altinn.studio/studioctl/internal/osutil"
+	"altinn.studio/studioctl/internal/studioctlserver"
+	"altinn.studio/studioctl/internal/ui"
+	"altinn.studio/studioctl/internal/ui/resourcegraph"
+)
+
+const (
+	// Name is the runtime's name on the command line (-r localtest-v2).
+	Name = "localtest-v2"
+
+	// EnvSourceRoot points at the research checkout's localtest/ folder, which `env up --dev <component>`
+	// builds component images from.
+	EnvSourceRoot = "STUDIOCTL_LOCALTEST_V2_SRC"
+
+	// graphID scopes devenv ownership labels to this runtime's graph.
+	graphID = "studioctl-localtest-v2"
+
+	teardownTimeout = 30 * time.Second
+	stoppingMessage = "Stopping localtest-v2 environment..."
+)
+
+var (
+	// ErrLocaltestRunning is returned when the localtest runtime holds the public origin's port.
+	ErrLocaltestRunning    = errors.New("the localtest runtime is running; stop it first with 'env down'")
+	errUnknownDevComponent = errors.New("unknown component for --dev")
+	errDevSourceMissing    = errors.New(
+		"--dev needs " + EnvSourceRoot + " to point at the research checkout's localtest/ folder",
+	)
+)
+
+// Env implements envtypes.Env for the localtest-v2 runtime.
+type Env struct {
+	cfg    *config.Config
+	out    *ui.Output
+	client container.ContainerClient
+}
+
+// NewEnv creates the localtest-v2 environment manager.
+func NewEnv(cfg *config.Config, out *ui.Output, client container.ContainerClient) *Env {
+	return &Env{cfg: cfg, out: out, client: client}
+}
+
+// Name returns the runtime name.
+func (e *Env) Name() string {
+	return Name
+}
+
+// Preflight validates prerequisites before startup: the localtest runtime must not hold port 8000, and a
+// dev build needs the research checkout.
+func (e *Env) Preflight(ctx context.Context, opts envtypes.UpOptions) error {
+	if err := envlocaltest.CheckForLegacyLocaltest(ctx, e.client); err != nil {
+		return fmt.Errorf("check for legacy localtest: %w", err)
+	}
+	info, err := e.client.ContainerInspect(ctx, v1components.ContainerLocaltest)
+	if err == nil && info.State.Running {
+		return ErrLocaltestRunning
+	}
+	if err != nil && !errors.Is(err, container.ErrContainerNotFound) {
+		return fmt.Errorf("inspect container %s: %w", v1components.ContainerLocaltest, err)
+	}
+	if _, err := devComponents(opts.DevComponents); err != nil {
+		return err
+	}
+	return nil
+}
+
+// Up starts the environment: writes the certificate and the proxy's route table, (re)starts
+// studioctl-server as the proxy, applies the containers, and waits until every component answers.
+func (e *Env) Up(ctx context.Context, upOpts envtypes.UpOptions) error {
+	toolchain := e.client.Toolchain()
+	e.out.Verbosef("Using container toolchain: %s via %s", toolchain.Platform, toolchain.AccessMode)
+
+	opts, err := e.options(upOpts)
+	if err != nil {
+		return err
+	}
+	if err := ensureCertificate(opts.CertDir); err != nil {
+		return err
+	}
+	if err := envtopology.WriteBoundTopologyConfig(
+		e.cfg.BoundTopologyBaseConfigPath(),
+		boundTopologyConfig(opts),
+	); err != nil {
+		return fmt.Errorf("write proxy routes: %w", err)
+	}
+	if err := localtestv2.WriteState(e.cfg, localtestv2.State{
+		CertificateDir: opts.CertDir,
+		ProxyPorts:     studioctlserver.LocaltestV2ProxyPorts(opts.Topology.IngressPort()),
+	}); err != nil {
+		return fmt.Errorf("record localtest-v2 state: %w", err)
+	}
+	if err := studioctlserver.EnsureStarted(ctx, e.cfg, opts.Topology.IngressPort()); err != nil {
+		return fmt.Errorf("ensure studioctl-server: %w", err)
+	}
+
+	if err := e.applyResources(ctx, resources(opts), len(opts.DevComponents) > 0); err != nil {
+		return err
+	}
+	e.out.Println("Waiting for the components to answer...")
+	if err := waitHealthy(ctx, e.out, healthTargets(opts)); err != nil {
+		return fmt.Errorf("localtest-v2 did not become healthy: %w", err)
+	}
+	e.out.Success("Environment healthy")
+
+	localtestURL := opts.Topology.LocaltestURL()
+	if upOpts.OpenBrowser {
+		if err := osutil.OpenContext(ctx, localtestURL); err != nil {
+			e.out.Warningf("Failed to open browser: %v", err)
+		}
+	}
+	if !upOpts.Detach {
+		return e.runForeground(ctx, localtestURL, opts)
+	}
+	e.out.Println("")
+	e.out.Println("localtest-v2 started in background.")
+	e.out.Printlnf("Access the platform at: %s", localtestURL)
+	e.out.Printlnf("Use '%s env logs -r %s' to view logs.", osutil.CurrentBin(), Name)
+	e.out.Printlnf("Use '%s env down -r %s' to stop.", osutil.CurrentBin(), Name)
+	return nil
+}
+
+// Down stops the environment and takes studioctl-server out of proxy mode.
+func (e *Env) Down(ctx context.Context) error {
+	hasResources, err := e.hasManagedResources(ctx)
+	if err != nil {
+		return err
+	}
+	if !hasResources {
+		return e.forgetState(ctx, envtypes.ErrAlreadyStopped)
+	}
+	if err := e.destroyResources(ctx, resources(e.defaultOptions()), stoppingMessage); err != nil {
+		return fmt.Errorf("stop environment: %w", err)
+	}
+	if err := e.forgetState(ctx, nil); err != nil {
+		return err
+	}
+	e.out.Success("Environment stopped")
+	return nil
+}
+
+// Reset stops the environment if needed and deletes its volumes.
+func (e *Env) Reset(ctx context.Context) error {
+	hasResources, err := e.hasManagedResources(ctx)
+	if err != nil {
+		return err
+	}
+	if hasResources {
+		if err := e.destroyResources(ctx, resources(e.defaultOptions()), stoppingMessage); err != nil {
+			return fmt.Errorf("stop environment: %w", err)
+		}
+	}
+	if err := e.forgetState(ctx, nil); err != nil {
+		return err
+	}
+	e.out.Println("Deleting persisted localtest-v2 data...")
+	for _, volume := range []string{volumePostgresData, volumeStorageBlobs, volumePolicyStore, volumeLocaltestData} {
+		if err := e.client.VolumeRemove(
+			ctx,
+			volume,
+			true,
+		); err != nil &&
+			!errors.Is(err, containertypes.ErrVolumeNotFound) {
+			return fmt.Errorf("remove volume %q: %w", volume, err)
+		}
+	}
+	e.out.Success("Environment data reset")
+	return nil
+}
+
+// Logs streams the containers' logs.
+func (e *Env) Logs(ctx context.Context, opts envtypes.LogsOptions) error {
+	streamer := envlocaltest.NewLogStreamer(e.client, e.out, containerNames(e.defaultOptions()))
+	component := opts.Component
+	if component != "" && !strings.HasPrefix(component, containerPrefix) {
+		component = containerPrefix + component
+	}
+	if err := streamer.Stream(ctx, component, opts.Follow, opts.JSON); err != nil {
+		return fmt.Errorf("stream logs: %w", err)
+	}
+	return nil
+}
+
+// Status returns the environment's container status.
+func (e *Env) Status(ctx context.Context) (*envlocaltest.Status, error) {
+	graph, err := buildResourceGraph(resources(e.defaultOptions()))
+	if err != nil {
+		return nil, err
+	}
+	exec, err := newResourceExecutor(e.client)
+	if err != nil {
+		return nil, err
+	}
+	snapshot, err := exec.Status(ctx, graph, executor.SkipResource(isImageResource))
+	if err != nil {
+		return nil, fmt.Errorf("get resource status: %w", err)
+	}
+
+	status := envlocaltest.Status{Containers: []envlocaltest.ContainerStatus{}, Running: false, AnyRunning: false}
+	ready := 0
+	for _, res := range graph.All() {
+		ctr, ok := res.(*resource.Container)
+		if !ok {
+			continue
+		}
+		resourceStatus, imageID := observedContainer(snapshot, ctr)
+		status.Containers = append(status.Containers, envlocaltest.ContainerStatus{
+			Name:    ctr.Name,
+			Image:   e.imageRef(ctx, ctr, imageID),
+			ImageID: imageID,
+			Status:  statusString(resourceStatus),
+		})
+		if resourceStatus.IsHealthy() {
+			ready++
+		}
+		if resourceStatus != executor.StatusDestroyed {
+			status.AnyRunning = true
+		}
+	}
+	status.Running = len(status.Containers) > 0 && ready == len(status.Containers)
+	return &status, nil
+}
+
+// observedContainer reads a container's status and image from the snapshot; a container studioctl does
+// not own counts as absent.
+func observedContainer(snapshot executor.Snapshot, ctr *resource.Container) (executor.Status, string) {
+	observed, present := snapshot.Resources[ctr.ID()]
+	if !present || !observed.Managed {
+		return executor.StatusDestroyed, ""
+	}
+	return observed.Status, observed.ImageID
+}
+
+// imageRef names the reference a container was pulled from, when that reference still resolves to the
+// build the container runs; a dev build or a moved tag has none.
+func (e *Env) imageRef(ctx context.Context, ctr *resource.Container, imageID string) string {
+	pulled, isPulled := ctr.Image.Resource().(*resource.PulledImage)
+	if !isPulled || imageID == "" {
+		return ""
+	}
+	info, err := e.client.ImageInspect(ctx, pulled.Ref)
+	if err != nil || info.ID != imageID {
+		return ""
+	}
+	return pulled.Ref
+}
+
+func statusString(status executor.Status) string {
+	if status == executor.StatusDestroyed {
+		return "not found"
+	}
+	if status == executor.StatusReady {
+		return "running"
+	}
+	return status.String()
+}
+
+// forgetState removes the runtime's state and, when studioctl-server runs, restarts it without the proxy.
+// The passthrough error is returned when the state is gone, so a caller can report "already stopped".
+func (e *Env) forgetState(ctx context.Context, passthrough error) error {
+	if err := localtestv2.RemoveState(e.cfg); err != nil {
+		return fmt.Errorf("forget localtest-v2 state: %w", err)
+	}
+	if err := studioctlserver.ReconcileIfRunning(ctx, e.cfg, envtopology.DefaultIngressPortString()); err != nil {
+		return fmt.Errorf("reconcile studioctl-server: %w", err)
+	}
+	return passthrough
+}
+
+func (e *Env) defaultOptions() *Options {
+	return defaultOptions(e.cfg.Images, localtestv2.CertificateDir(e.cfg))
+}
+
+func (e *Env) options(upOpts envtypes.UpOptions) (*Options, error) {
+	opts := e.defaultOptions()
+	opts.RuntimeUser, opts.UsernsMode, opts.RelabelBinds = v1components.RuntimeUser(e.client.Toolchain())
+	if upOpts.LatestImages {
+		opts.Images.LocaltestV2.UseTag("latest")
+	}
+	dev, err := devComponents(upOpts.DevComponents)
+	if err != nil {
+		return nil, err
+	}
+	if len(dev) > 0 {
+		root := filepath.Clean(strings.TrimSpace(os.Getenv(EnvSourceRoot)))
+		if root == "" || root == "." {
+			return nil, errDevSourceMissing
+		}
+		if _, err := os.Stat(root); err != nil {
+			return nil, fmt.Errorf("%w: %s: %w", errDevSourceMissing, root, err)
+		}
+		opts.DevSourceRoot = root
+		opts.DevComponents = dev
+	}
+	return opts, nil
+}
+
+// devComponents validates --dev names; "all" selects every component that has a dev build.
+func devComponents(names []string) (map[string]bool, error) {
+	selected := map[string]bool{}
+	buildable := DevBuildable()
+	for _, name := range names {
+		if name == "all" {
+			for _, b := range buildable {
+				selected[b] = true
+			}
+			continue
+		}
+		if !slices.Contains(buildable, name) {
+			return nil, fmt.Errorf(
+				"%w: %s (one of %s, all)",
+				errUnknownDevComponent,
+				name,
+				strings.Join(buildable, ", "),
+			)
+		}
+		selected[name] = true
+	}
+	return selected, nil
+}
+
+func (e *Env) runForeground(ctx context.Context, localtestURL string, opts *Options) error {
+	e.out.Println("")
+	e.out.Println("localtest-v2 is running. Press Ctrl+C to stop.")
+	e.out.Printlnf("Access the platform at: %s", localtestURL)
+
+	streamer := envlocaltest.NewLogStreamer(e.client, e.out, containerNames(opts))
+	if err := streamer.Stream(ctx, "", true, false); err != nil {
+		e.out.Verbosef("log streaming ended: %v", err)
+	}
+	e.out.Println("")
+	e.out.Println(stoppingMessage)
+
+	teardownCtx, cancel := context.WithTimeout(context.Background(), teardownTimeout)
+	defer cancel()
+	//nolint:contextcheck // intentionally using new context for cleanup after cancellation
+	if err := e.destroyResources(teardownCtx, resources(opts), ""); err != nil {
+		e.out.Warningf("Failed to stop environment cleanly: %v", err)
+		return err
+	}
+	//nolint:contextcheck // same cleanup context
+	if err := e.forgetState(teardownCtx, nil); err != nil {
+		return err
+	}
+	e.out.Println("Environment stopped.")
+	return nil
+}
+
+func (e *Env) hasManagedResources(ctx context.Context) (bool, error) {
+	graph, err := buildResourceGraph(resources(e.defaultOptions()))
+	if err != nil {
+		return false, err
+	}
+	exec, err := newResourceExecutor(e.client)
+	if err != nil {
+		return false, err
+	}
+	snapshot, err := exec.Status(ctx, graph, executor.SkipResource(isImageResource))
+	if err != nil {
+		return false, fmt.Errorf("get resource status: %w", err)
+	}
+	for _, observed := range snapshot.Resources {
+		if !observed.Managed || observed.Status == executor.StatusDestroyed {
+			continue
+		}
+		return true, nil
+	}
+	return false, nil
+}
+
+func (e *Env) applyResources(ctx context.Context, resources []resource.Resource, building bool) error {
+	graph, err := buildResourceGraph(resources)
+	if err != nil {
+		return err
+	}
+	exec, err := newResourceExecutor(e.client)
+	if err != nil {
+		return err
+	}
+	spinnerMsg := "Starting localtest-v2 environment..."
+	if building {
+		spinnerMsg = "Building and starting localtest-v2 environment..."
+	}
+
+	var renderer resourcegraph.Renderer
+	outputs, err := exec.Apply(ctx, graph, executor.WithApplyPlan(func(plan executor.ApplyPlan) error {
+		planned := make([]executor.PlannedResource, 0, len(plan.Destroy)+len(plan.Reconcile))
+		planned = append(planned, plan.Destroy...)
+		planned = append(planned, plan.Reconcile...)
+		e.startRenderer(exec, &renderer, planned, resourcegraph.OperationApply, plan.Snapshot.Statuses(), spinnerMsg)
+		return nil
+	}))
+	if err != nil {
+		if renderer != nil {
+			renderer.FailAll(err.Error())
+			renderer.Stop()
+		}
+		return fmt.Errorf("start environment: %w", err)
+	}
+	if renderer != nil {
+		renderer.Stop()
+	}
+	for _, res := range resources {
+		image, ok := res.(*resource.PulledImage)
+		if !ok {
+			continue
+		}
+		if output, found := outputs.Image(image.ID()); found && output.Stale {
+			e.out.Warningf("Could not reach the registry for %s; using the copy already on this machine.", image.Ref)
+		}
+	}
+	e.out.Success("Containers started")
+	return nil
+}
+
+func (e *Env) destroyResources(ctx context.Context, resources []resource.Resource, logStartMessage string) error {
+	graph, err := buildResourceGraph(resources)
+	if err != nil {
+		return err
+	}
+	exec, err := newResourceExecutor(e.client)
+	if err != nil {
+		return err
+	}
+	var renderer resourcegraph.Renderer
+	if err := exec.Destroy(ctx, graph, executor.WithDestroyPlan(func(plan executor.DestroyPlan) error {
+		e.startRenderer(
+			exec,
+			&renderer,
+			plan.Destroy,
+			resourcegraph.OperationDestroy,
+			plan.Snapshot.Statuses(),
+			logStartMessage,
+		)
+		return nil
+	})); err != nil {
+		if renderer != nil {
+			renderer.FailAll(err.Error())
+			renderer.Stop()
+		}
+		return fmt.Errorf("destroy resources: %w", err)
+	}
+	if renderer != nil {
+		renderer.Stop()
+	}
+	return nil
+}
+
+func (e *Env) startRenderer(
+	exec *executor.Executor,
+	renderer *resourcegraph.Renderer,
+	resources []executor.PlannedResource,
+	operation resourcegraph.Operation,
+	statuses map[resource.ResourceID]executor.Status,
+	logStartMessage string,
+) {
+	switch resourcegraph.DetectMode(e.out, e.cfg.Verbose) {
+	case resourcegraph.ModeTable:
+		*renderer = resourcegraph.NewTableWithPlan(e.out, resources, operation, statuses)
+	case resourcegraph.ModeCompact:
+		*renderer = resourcegraph.NewCompactWithPlan(e.out, resources, operation, statuses)
+	case resourcegraph.ModeLog:
+		*renderer = resourcegraph.NewLogWithPlan(e.out, resources, operation, statuses, logStartMessage)
+	default:
+		*renderer = resourcegraph.NewLogWithPlan(e.out, resources, operation, statuses, logStartMessage)
+	}
+	(*renderer).Start()
+	exec.SetObserver(*renderer)
+}
+
+func newResourceExecutor(client container.ContainerClient) (*executor.Executor, error) {
+	exec := executor.New()
+	if err := exec.RegisterBackend(containerbackend.New(client)); err != nil {
+		return nil, fmt.Errorf("register container backend: %w", err)
+	}
+	return exec, nil
+}
+
+func buildResourceGraph(resources []resource.Resource) (*resource.Graph, error) {
+	graph := resource.NewGraph(resource.GraphID(graphID))
+	for _, res := range resources {
+		if err := graph.Add(res); err != nil {
+			return nil, fmt.Errorf("add resource %q to graph: %w", res.ID(), err)
+		}
+	}
+	if err := graph.Validate(); err != nil {
+		return nil, fmt.Errorf("validate resource graph: %w", err)
+	}
+	return graph, nil
+}
+
+func isImageResource(res resource.Resource) bool {
+	_, ok := res.(resource.ImageResource)
+	return ok
+}
