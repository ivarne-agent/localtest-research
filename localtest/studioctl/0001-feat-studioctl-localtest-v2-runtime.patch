+using Altinn.Studio.StudioctlServer.Platform;
+
+namespace Altinn.Studio.StudioctlServer.Provisioning;
+
+internal static class ServiceCollectionExtensions
+{
+    public static IServiceCollection AddProvisioningServices(
+        this IServiceCollection services,
+        IConfiguration configuration
+    )
+    {
+        services.AddHttpClient(
+            AppProvisioner.HttpClientName,
+            static client =>
+            {
+                client.Timeout = TimeSpan.FromSeconds(30);
+                client.DefaultRequestHeaders.UserAgent.ParseAdd(StudioctlUserAgent.Value);
+            }
+        );
+        services.AddSingleton(AppProvisionerOptions.FromConfiguration(configuration));
+        services.AddSingleton<AppProvisioner>();
+        return services;
+    }
+}
diff --git a/src/cli/studioctl-server/Proxy/PlatformProxy.cs b/src/cli/studioctl-server/Proxy/PlatformProxy.cs
new file mode 100644
index 0000000000..e82bb710dd
--- /dev/null
+++ b/src/cli/studioctl-server/Proxy/PlatformProxy.cs
@@ -0,0 +1,86 @@
+using System.Net;
+using Altinn.Studio.EnvTopology;
+using Microsoft.AspNetCore.Server.Kestrel.Core;
+using Yarp.ReverseProxy.Forwarder;
+
+namespace Altinn.Studio.StudioctlServer.Proxy;
+
+/// <summary>
+/// The localtest-v2 front door: every request on a platform port is matched against the bound topology
+/// (the component prefixes studioctl wrote, plus /{org}/{app} for each discovered app) and forwarded to the
+/// loopback port behind it. Nothing is buffered, so server-sent events stream, and an upstream gets five
+/// minutes, which a PDF render or a large upload can need.
+/// </summary>
+internal static class PlatformProxy
+{
+    private const long MaxRequestBodyBytes = 200L * 1024 * 1024;
+
+    private static readonly HttpMessageInvoker _client = new(
+        new SocketsHttpHandler
+        {
+            UseProxy = false,
+            AllowAutoRedirect = false,
+            AutomaticDecompression = DecompressionMethods.None,
+            UseCookies = false,
+            EnableMultipleHttp2Connections = true,
+            PooledConnectionLifetime = TimeSpan.FromMinutes(2),
+            ConnectTimeout = TimeSpan.FromSeconds(5),
+        }
+    );
+
+    private static readonly ForwarderRequestConfig _requestConfig = new() { ActivityTimeout = TimeSpan.FromMinutes(5) };
+
+    public static void ConfigureKestrel(IConfiguration configuration, KestrelServerOptions options)
+    {
+        var proxy = ProxyOptions.FromConfiguration(configuration);
+        if (!proxy.Enabled)
+            return;
+
+        options.Limits.MaxRequestBodySize = MaxRequestBodyBytes;
+        foreach (var port in proxy.Ports)
+            options.ListenAnyIP(port);
+    }
+
+    /// <summary>A request that arrived over TCP; the control API lives on the Unix socket, which has no address.</summary>
+    public static bool IsProxyRequest(HttpContext context) => context.Connection.LocalIpAddress is not null;
+
+    public static async Task Handle(HttpContext context)
+    {
+        var options = context.RequestServices.GetRequiredService<ProxyOptions>();
+        var index = context.RequestServices.GetRequiredService<BoundTopologyIndexAccessor>().Current;
+        var path = context.Request.Path.Value ?? "/";
+
+        var match =
+            index.MatchRequest(context.Request.Host.Host, path) ?? index.MatchRequest(options.CanonicalHost, path);
+        if (match?.HttpDestinationUri is not { } destination)
+        {
+            context.Response.StatusCode = StatusCodes.Status404NotFound;
+            context.Response.ContentType = "text/plain; charset=utf-8";
+            await context.Response.WriteAsync(
+                $"No route for {context.Request.Host.Host}{path}. Is the localtest-v2 environment up (studioctl env status -r localtest-v2)?",
+                context.RequestAborted
+            );
+            return;
+        }
+
+        if (!match.Route.Enabled)
+        {
+            context.Response.StatusCode = StatusCodes.Status404NotFound;
+            return;
+        }
+
+        var forwarder = context.RequestServices.GetRequiredService<IHttpForwarder>();
+        var transformer = context.RequestServices.GetRequiredService<PlatformTransformer>();
+        var error = await forwarder.SendAsync(context, destination.ToString(), _client, _requestConfig, transformer);
+        if (error == ForwarderError.None || context.Response.HasStarted)
+            return;
+
+        var feature = context.GetForwarderErrorFeature();
+        context.Response.StatusCode = StatusCodes.Status502BadGateway;
+        context.Response.ContentType = "text/plain; charset=utf-8";
+        await context.Response.WriteAsync(
+            $"{match.Route.Component} at {destination} did not answer: {error} {feature?.Exception?.Message}",
+            context.RequestAborted
+        );
+    }
+}
diff --git a/src/cli/studioctl-server/Proxy/PlatformTransformer.cs b/src/cli/studioctl-server/Proxy/PlatformTransformer.cs
new file mode 100644
index 0000000000..ba2b8ccae0
--- /dev/null
+++ b/src/cli/studioctl-server/Proxy/PlatformTransformer.cs
@@ -0,0 +1,56 @@
+using Microsoft.Net.Http.Headers;
+using Yarp.ReverseProxy.Forwarder;
+
+namespace Altinn.Studio.StudioctlServer.Proxy;
+
+/// <summary>
+/// What the localtest ingress always did for the platform behind it: the request keeps the browser-facing Host
+/// (the components build their public links and validate issuers from it), and <c>Secure</c> is stripped from
+/// every cookie, because the production components set it and the local origin is plain http.
+/// </summary>
+internal sealed class PlatformTransformer : HttpTransformer
+{
+    public override async ValueTask TransformRequestAsync(
+        HttpContext httpContext,
+        HttpRequestMessage proxyRequest,
+        string destinationPrefix,
+        CancellationToken cancellationToken
+    )
+    {
+        await base.TransformRequestAsync(httpContext, proxyRequest, destinationPrefix, cancellationToken);
+        proxyRequest.Headers.Host = httpContext.Request.Host.Value;
+    }
+
+    public override async ValueTask<bool> TransformResponseAsync(
+        HttpContext httpContext,
+        HttpResponseMessage? proxyResponse,
+        CancellationToken cancellationToken
+    )
+    {
+        var proceed = await base.TransformResponseAsync(httpContext, proxyResponse, cancellationToken);
+        if (!proceed || proxyResponse is null)
+            return proceed;
+
+        var headers = httpContext.Response.Headers;
+        if (headers.TryGetValue(HeaderNames.SetCookie, out var cookies) && cookies.Count > 0)
+        {
+            headers[HeaderNames.SetCookie] = new Microsoft.Extensions.Primitives.StringValues([
+                .. cookies.Select(StripSecure),
+            ]);
+        }
+
+        return true;
+    }
+
+    private static string? StripSecure(string? cookie)
+    {
+        if (cookie is null)
+            return null;
+
+        var parts = cookie
+            .Split(';')
+            .Select(static part => part.Trim())
+            .Where(static part => !part.Equals("Secure", StringComparison.OrdinalIgnoreCase));
+        return string.Join("; ", parts);
+    }
+}
