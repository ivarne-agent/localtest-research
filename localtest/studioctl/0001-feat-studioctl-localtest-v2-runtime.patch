diff --git a/src/cli/internal/localtestv2/state.go b/src/cli/internal/localtestv2/state.go
new file mode 100644
index 0000000000..947bd8d4f1
--- /dev/null
+++ b/src/cli/internal/localtestv2/state.go
@@ -0,0 +1,91 @@
+// Package localtestv2 holds the state the localtest-v2 runtime shares with the rest of studioctl: while the
+// runtime is up, studioctl-server proxies the platform's public origin and apps sign platform access tokens
+// with the runtime's certificate, and both learn that from the state file the runtime writes.
+package localtestv2
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"altinn.studio/studioctl/internal/config"
+	"altinn.studio/studioctl/internal/osutil"
+)
+
+const (
+	stateDirName  = "generated/localtest-v2"
+	stateFileName = "state.json"
+
+	// CertificateFileName is the shared test certificate every app and component signs platform
+	// access tokens with, and the components validate them against.
+	CertificateFileName = "localtest-accesstoken.pfx"
+)
+
+// State describes a running localtest-v2 environment.
+type State struct {
+	// CertificateDir holds CertificateFileName on the host.
+	CertificateDir string `json:"certificateDir"`
+	// ProxyPorts are the host ports studioctl-server serves the platform on.
+	ProxyPorts []string `json:"proxyPorts"`
+}
+
+// CertificatePath is the host path of the shared test certificate.
+func (s State) CertificatePath() string {
+	return filepath.Join(s.CertificateDir, CertificateFileName)
+}
+
+// StatePath returns where the runtime records that it is up.
+func StatePath(cfg *config.Config) string {
+	return filepath.Join(cfg.DataDir, stateDirName, stateFileName)
+}
+
+// CertificateDir returns where the runtime keeps the shared test certificate.
+func CertificateDir(cfg *config.Config) string {
+	return filepath.Join(cfg.DataDir, "infra", "localtest-v2", "certs")
+}
+
+// ReadState returns the recorded state, and whether there is one.
+func ReadState(cfg *config.Config) (State, bool, error) {
+	data, err := os.ReadFile(StatePath(cfg))
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return noState(), false, nil
+		}
+		return noState(), false, fmt.Errorf("read localtest-v2 state: %w", err)
+	}
+	state := noState()
+	if err := json.Unmarshal(data, &state); err != nil {
+		return noState(), false, fmt.Errorf("parse localtest-v2 state %s: %w", StatePath(cfg), err)
+	}
+	return state, true, nil
+}
+
+func noState() State {
+	return State{CertificateDir: "", ProxyPorts: nil}
+}
+
+// WriteState records that the runtime is up.
+func WriteState(cfg *config.Config, state State) error {
+	path := StatePath(cfg)
+	if err := os.MkdirAll(filepath.Dir(path), osutil.DirPermDefault); err != nil {
+		return fmt.Errorf("create localtest-v2 state directory: %w", err)
+	}
+	data, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return fmt.Errorf("marshal localtest-v2 state: %w", err)
+	}
+	if err := os.WriteFile(path, append(data, '\n'), osutil.FilePermDefault); err != nil {
+		return fmt.Errorf("write localtest-v2 state: %w", err)
+	}
+	return nil
+}
+
+// RemoveState records that the runtime is down.
+func RemoveState(cfg *config.Config) error {
+	if err := os.Remove(StatePath(cfg)); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("remove localtest-v2 state: %w", err)
+	}
+	return nil
+}
diff --git a/src/cli/internal/localtestv2/state_test.go b/src/cli/internal/localtestv2/state_test.go
new file mode 100644
index 0000000000..0ddc6e0d60
--- /dev/null
+++ b/src/cli/internal/localtestv2/state_test.go
@@ -0,0 +1,59 @@
+package localtestv2_test
+
+import (
+	"testing"
+
+	"altinn.studio/studioctl/internal/config"
+	"altinn.studio/studioctl/internal/localtestv2"
+)
+
+func TestReadStateOnFreshDataDir(t *testing.T) {
+	t.Parallel()
+	cfg := &config.Config{DataDir: t.TempDir()}
+	_, up, err := localtestv2.ReadState(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if up {
+		t.Fatal("no state was written, so the runtime is not up")
+	}
+}
+
+func TestStateRoundTrip(t *testing.T) {
+	t.Parallel()
+	cfg := &config.Config{DataDir: t.TempDir()}
+	want := localtestv2.State{CertificateDir: localtestv2.CertificateDir(cfg), ProxyPorts: []string{"8000", "5101"}}
+	if err := localtestv2.WriteState(cfg, want); err != nil {
+		t.Fatal(err)
+	}
+
+	got, up, err := localtestv2.ReadState(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !up {
+		t.Fatal("state was written, so the runtime is up")
+	}
+	if got.CertificateDir != want.CertificateDir || len(got.ProxyPorts) != 2 || got.ProxyPorts[1] != "5101" {
+		t.Errorf("got %+v, want %+v", got, want)
+	}
+	if got.CertificatePath() != want.CertificateDir+"/"+localtestv2.CertificateFileName {
+		t.Errorf("certificate path = %q", got.CertificatePath())
+	}
+}
+
+func TestRemoveStateIsIdempotent(t *testing.T) {
+	t.Parallel()
+	cfg := &config.Config{DataDir: t.TempDir()}
+	if err := localtestv2.WriteState(cfg, localtestv2.State{CertificateDir: "/certs", ProxyPorts: nil}); err != nil {
+		t.Fatal(err)
+	}
+	for range 2 {
+		if err := localtestv2.RemoveState(cfg); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, up, err := localtestv2.ReadState(cfg); err != nil || up {
+		t.Fatalf("after remove: up=%v err=%v", up, err)
+	}
+}
