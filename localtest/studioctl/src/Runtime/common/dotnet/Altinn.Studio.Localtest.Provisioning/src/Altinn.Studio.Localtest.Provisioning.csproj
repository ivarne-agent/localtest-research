<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Altinn.Studio.Localtest.Provisioning</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <Description>
      Pushes an Altinn app's artefacts to the localtest platform the way Altinn Studio deploys it; shared by
      studioctl-server and the Aspire hosting package.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Altinn.Studio.Localtest.Provisioning.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
