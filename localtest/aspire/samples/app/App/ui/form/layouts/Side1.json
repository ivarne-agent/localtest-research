{
  "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/layout/layout.schema.v1.json",
  "data": {
    "hidden": false,
    "layout": [
      {
        "id": "header",
        "type": "Header",
        "size": "L",
        "textResourceBindings": { "title": "appName" }
      },
      {
        "id": "name",
        "type": "Input",
        "dataModelBindings": { "simpleBinding": "name" },
        "textResourceBindings": { "title": "Navn" },
        "required": true
      },
      {
        "id": "message",
        "type": "TextArea",
        "dataModelBindings": { "simpleBinding": "message" },
        "textResourceBindings": { "title": "Melding" }
      },
      {
        "id": "submit",
        "type": "Button",
        "textResourceBindings": { "title": "Send inn" }
      }
    ]
  }
}
