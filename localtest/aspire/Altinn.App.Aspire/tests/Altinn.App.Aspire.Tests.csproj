<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Altinn.App.Aspire.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Altinn.App.Aspire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- studioctl's golden snapshot of the resolved environment (default, and with every group and every dev build as a rootless
       user), the file the reader must agree with. TODO task 27b: golden-v1/ is the snapshot of the v1 manifest the package
       still reads (src/Manifest/manifest.v1.json); 27b reads manifest v2 and compares with studioctl's current snapshot. -->
  <ItemGroup>
    <Content
      Include="golden-v1/environment.golden.json"
      Link="golden/environment.golden.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <!-- studioctl's snapshot of the app environment (internal/cmd/app) and the app codes it writes (internal/appsecrets). -->
    <Content
      Include="../../../studioctl/src/cli/internal/cmd/app/testdata/app-environment.golden.json"
      Link="golden/app-environment.golden.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../../../studioctl/src/cli/internal/appsecrets/testdata/app-codes.golden.json"
      Link="golden/app-codes.golden.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <!-- The sample app's project file, which the sample model adds as the sample AppHost does. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SampleAppProject</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../samples/app/App/App.csproj'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
