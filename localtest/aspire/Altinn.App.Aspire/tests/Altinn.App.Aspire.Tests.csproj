<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Altinn.App.Aspire.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Altinn.App.Aspire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- studioctl's golden snapshot of the resolved environment (default, and with every group and every dev build as a rootless
       user), the file the reader must agree with. -->
  <ItemGroup>
    <Content
      Include="../../../studioctl/src/cli/internal/cmd/env/localtestv2/testdata/environment.golden.json"
      Link="golden/environment.golden.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
