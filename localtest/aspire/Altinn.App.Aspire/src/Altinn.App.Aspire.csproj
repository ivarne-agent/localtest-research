<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Altinn.App.Aspire</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Altinn.App.Aspire</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Altinn</Authors>
    <PackageTags>altinn;aspire;localtest</PackageTags>
    <Description>
      Runs the Altinn localtest platform (the localtest-v2 container stack) as container resources of a .NET Aspire
      AppHost, from the same manifest studioctl runs, with the localtest container as the front door on
      http://local.altinn.cloud:8000.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Altinn.App.Aspire.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <!--
    studioctl's manifest, the files that ship with it (every file in the folders beside it; the top-level files are the
    manifest, its README and studioctl's code) and the shared test certificate studioctl embeds too, by relative path:
    one copy of each.
  -->
  <PropertyGroup>
    <ManifestDirectory>../../../studioctl/src/cli/internal/localtestv2/manifest/</ManifestDirectory>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="../../../studioctl/src/cli/internal/localtestv2/manifest/manifest.json"
      LogicalName="Altinn.App.Aspire.manifest.json"
      Link="Manifest/manifest.json"
    />
    <EmbeddedResource
      Include="$(ManifestDirectory)**/*"
      Exclude="$(ManifestDirectory)*"
      LogicalName="Altinn.App.Aspire.manifest-files/%(RecursiveDir)%(Filename)%(Extension)"
      Link="Manifest/files/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <EmbeddedResource
      Include="../../../studioctl/src/cli/internal/cmd/env/localtestv2/assets/localtest-accesstoken.pfx"
      LogicalName="Altinn.App.Aspire.localtest-accesstoken.pfx"
      Link="Certificate/localtest-accesstoken.pfx"
    />
  </ItemGroup>
</Project>
