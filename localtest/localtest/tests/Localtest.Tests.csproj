<Project Sdk="Microsoft.NET.Sdk">
  <!-- The localtest app's tests: the route table, the forwarder's 503s, and the registration API against fake apps and a
       fake platform on loopback ports. dotnet test localtest/localtest/tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Localtest.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Localtest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The components' service-discovery registration (copied into each component's fakes), tested here. -->
    <Compile Include="../../components/shared/fakes/ServiceDiscovery/LocaltestServiceDiscovery.cs" Link="Shared/LocaltestServiceDiscovery.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
