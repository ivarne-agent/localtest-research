<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of the front door's OTLP helper (localtest/localtest/Telemetry/LocaltestOtlp.cs) against a fake collector on a
    loopback port; no stack needed. Until task 63 the components carried copies of it; they now inline the same rule in
    their Program.cs directives (UseOtlpExporter, the environment detector, the HttpClient.Otlp filter), which these
    tests describe as well.
      dotnet test localtest/components/shared/Otlp.Tests
    The consumers carry different OpenTelemetry versions (1.15.3 in Authorization through Altinn.Authorization.ServiceDefaults,
    1.18.0 in Correspondence, 1.19.x elsewhere), so the version is a property:
      dotnet test localtest/components/shared/Otlp.Tests -p:OtelVersion=1.15.3
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Localtest.Shared.Otlp.Tests</RootNamespace>
    <OtelVersion Condition="'$(OtelVersion)' == ''">1.19.1</OtelVersion>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="$(OtelVersion)" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OtelVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- The front door's helper, the one implementation left. -->
    <Compile Include="../../../localtest/Telemetry/LocaltestOtlp.cs" Link="FrontDoor/LocaltestOtlp.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
