<Project>
  <!-- Evaluated after each vendored project file (DirectoryBuildTargetsPath); item changes belong here. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildProjectDirectory)'))" Condition="'$(LocaltestIsVendoredProject)' == 'true'" />

  <!--
    The localtest fakes implement interfaces that live in the host assembly itself (IPolicyRepository, IProfile,
    IAccessManagementWrapper, ...), so, as in the authentication component, they are compiled into the host from
    the adjacent fakes/ folder instead of being a separate project.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Altinn.Authorization'">
    <Compile Include="$(MSBuildThisFileDirectory)fakes/**/*.cs" LinkBase="Localtest" />
  </ItemGroup>
</Project>
