{
  "name": "receipt-react-app",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack-dev-server --config webpack.config.development.js --mode development",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.production.js --progress",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=lcov",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"./src/**/*.ts*\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist compiled"
  },
  "author": "Altinn",
  "license": "3-Clause BSD",
  "dependencies": {
    "@material-ui/core": "4.12.4",
    "@navikt/aksel-icons": "^8.12.1",
    "axios": "1.20.0",
    "classnames": "2.5.1",
    "dompurify": "3.4.17",
    "html-react-parser": "5.2.17",
    "marked": "15.0.12",
    "moment": "2.31.0",
    "react": "18.3.1",
    "react-content-loader": "7.1.2",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "7.29.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/jsdom": "21.1.7",
    "@types/marked": "6.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "babel-jest": "30.5.2",
    "babel-loader": "10.1.1",
    "cross-env": "7.0.3",
    "css-loader": "7.1.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fork-ts-checker-notifier-webpack-plugin": "9.0.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-fixed-jsdom": "0.0.11",
    "mini-css-extract-plugin": "2.10.2",
    "msw": "2.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "6.1.3",
    "source-map-loader": "5.0.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "typescript": "4.9.5",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6"
  },
  "packageManager": "yarn@3.8.7",
  "jest": {
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.(js|jsx|mjs|cjs)$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(until-async|msw|@mswjs|rettime|@open-draft)/)"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js",
      "^src/(.*)$": "<rootDir>/src/$1",
      "^testConfig/(.*)$": "<rootDir>/testConfig/$1"
    },
    "testRegex": "(/__tests__/.*|.*.(test|spec)).(ts|tsx|js|jsx)$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/compiled/",
      "/dist/"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "mjs"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/testConfig/setupTests.ts"
    ],
    "testEnvironmentOptions": {
      "url": "https://localhost/receipt/mockInstanceOwnerId/6697de17-18c7-4fb9-a428-d6a414a797ae",
      "customExportConditions": [
        ""
      ]
    },
    "testEnvironment": "<rootDir>/testConfig/jsdomEnvironment.js"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 10",
    "not op_mini all"
  ],
  "collectCoverageFrom": [
    "!__tests__/**/*",
    "src/**/*.{ts,tsx}"
  ]
}
