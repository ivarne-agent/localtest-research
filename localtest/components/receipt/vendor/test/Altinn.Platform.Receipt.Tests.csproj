    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\backend\Altinn.Receipt\Altinn.Platform.Receipt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="selfSignedTestCertificate.pfx">
