<Project>
  <!-- Evaluated after each vendored project file (DirectoryBuildTargetsPath); item changes belong here. -->
  <PropertyGroup>
    <LocaltestVendoredBuildTargets Condition="'$(LocaltestIsVendoredProject)' == 'true'">$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildProjectDirectory)'))</LocaltestVendoredBuildTargets>
  </PropertyGroup>
  <Import Project="$(LocaltestVendoredBuildTargets)" Condition="'$(LocaltestVendoredBuildTargets)' != '' And Exists('$(LocaltestVendoredBuildTargets)')" />

  <!--
    The localtest fakes implement interfaces that live in the host assembly itself (ICloudEventRepository,
    ISubscriptionRepository, IEventsQueueClient, ...) and use its internals (WebhookService.HttpClientName), so they
    are compiled into the host from the adjacent fakes/ folder instead of being a separate project.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Altinn.Platform.Events'">
    <!-- Service discovery by name for the #if LOCALTEST registration in Program.cs (planned-components/service-discovery.md). -->
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <!-- OTLP for the #else of the Azure Monitor exporters in Program.cs (fakes/Otlp, TODO.md task 53), at the host's OpenTelemetry version. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <Compile Include="$(MSBuildThisFileDirectory)fakes/**/*.cs" LinkBase="Localtest" />
    <!-- The startup SQL the localtest database step runs (fakes/Startup/*.sql), read as Localtest.{name}.sql. -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)fakes/**/*.sql" LinkBase="Localtest" LogicalName="Localtest.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
